# Copy to backend/.env (optional). On your own computer the AI key is set inside the app: Settings tab.
PORT=3001
JAVA_IMAGE=eclipse-temurin:21-jdk
RUN_TIMEOUT_MS=5000
COMPILE_TIMEOUT_MS=15000
MAX_CONCURRENT_RUNS=4

# ---- Public mode (for sharing with strangers) ----
# PUBLIC_MODE=true     visitors bring their own Gemini key (kept in their browser); history is per browser;
#                      server settings can't be changed; per-IP rate limits are on.
# TRUST_PROXY=1        set ONLY when behind a tunnel/reverse proxy so rate limits see the real visitor IP
# HOST=0.0.0.0         set on a server behind a reverse proxy (default is localhost only)
# ALLOWED_ORIGINS=https://your-frontend.example.com   only needed if the frontend is hosted on a different domain
